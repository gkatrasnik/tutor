# Public application origin
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres. Use the pooled URL at runtime and the direct URL for migrations.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Private Vercel Blob store connected to this project
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_example

# Fixed AI configuration
# Use the dedicated Tutor key with a $5 monthly spend quota in every environment.
AI_GATEWAY_API_KEY=your_ai_gateway_api_key
TUTOR_MODEL=alibaba/qwen3.7-flash
EMBEDDING_MODEL=cohere/embed-v4.0
EMBEDDING_DIMENSION=1536

# Comma-separated, normalized during the auth iteration
ADMIN_EMAILS=admin@example.com

# Neon Auth. Enable Auth in the Neon/Vercel integration to obtain the base URL.
# Generate one stable secret of at least 32 characters for all deployments.
NEON_AUTH_BASE_URL=https://your-branch.neonauth.your-region.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-a-stable-secret-at-least-32-characters
